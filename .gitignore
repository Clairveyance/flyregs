# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (catch-all -- .env.example below is the one deliberate exception)
.env
.env.*
!.env.example

# credentials
google-service-account.json
*service-account*.json

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# local scratch output (downloaded PDFs, rendered page images, pilot transcripts)
scratch/
scratchpad/

# background-agent isolated worktrees (each is a full nested clone with its
# own .git) -- transient tooling state, never source of truth. A worktree's
# real output is either merged back into the main tree by whoever dispatched
# it, or it was a dead end; either way this directory itself is not meant to
# be committed.
.claude/worktrees/

# AIM sync scratch — large re-downloaded source PDF and its regenerated
# caption->page lookup (rebuilt fresh every sync_aim.sh run by
# sync/build_aim_pdf_pages.py). sync/aim_pdf_table_headers.json is NOT
# listed here — it's a curated static asset, not regenerated automatically.
aim_full.pdf
aim_pdf_pages.json

# FAR PDF cross-reference audit scratch — far_pdf_audit.sh downloads real
# CFR volumes to a mktemp dir (self-cleaning) and only copies the small
# extracted-text JSON here transiently before deleting it; the report file
# is meant to be read then discarded/regenerated, not tracked.
far_pdf_sections.json
far_pdf_crossref_report.json

# one-off analysis reports (regenerate via their scripts, not source of truth)
header_leak_report.json
header_leak_fixed_docs.json
broken_headings_report.json
figure_miss_audit.json
heading_gaps_categorized.json
heading_gaps_report.json
inline_lists_report.json
ocr_scans_report.json
sync/ad_parts_generic_risk_flagged.json
sync/superseded_engine_mentions_preview.json

# fact-deck authoring (Anthropic Batches API) — resumable batch-id/id-map
# checkpoint state, not source of truth; author_fact_deck.py regenerates
# these on each run
scripts/.fact_deck_batch_state*.json
scripts/.fact_deck_id_map*.json
scripts/.fact_deck_verify_state.json

# question-bank authoring (Anthropic Batches API) — same resumable
# checkpoint-state pattern as fact-deck above; author_question_bank.py
# regenerates these on each run
scripts/.question_bank_batch_state*.json
scripts/.question_bank_id_map*.json
scripts/.question_bank_verify_state.json
scripts/.question_bank_sources_snapshot*.json

# Aviation Dictionary sourcing scratch — raw scraped/OCR'd source text and
# batch-job checkpoint state the load_dictionary_*.py scripts consume and
# regenerate; not source of truth
sync/.dictionary_contractions_source.html
sync/.dictionary_prose_batch_state.json
sync/.dictionary_prose_id_map.json
sync/.contractions_defs_batch_state.json
sync/.contractions_defs_id_map.json
sync/.contractions_defs_results.json
sync/.contractions_defs_unsure_review.json
sync/.contractions_defs_final_review.json
sync/.dictionary_sources/
sync/.iph_appendix_b_raw.txt
sync/.phak_appendix_b_outline.txt
sync/.weather_appendix_e_raw.txt
supabase/.temp/
scripts/audit_reports/

# flagged-fact repair pass (Anthropic Batches API) — same resumable
# checkpoint-state pattern as the authoring passes above;
# repair_flagged_facts.py regenerates these on each run
scripts/.repair_flagged_batch_state.json
scripts/.repair_flagged_id_map.json

# dictionary-facts authoring (Anthropic Batches API) — same resumable
# checkpoint-state pattern as fact-deck/question-bank above;
# author_dictionary_facts.py regenerates these on each run
scripts/.dictionary_facts_batch_state*.json
scripts/.dictionary_facts_id_map*.json
scripts/.dictionary_facts_sources_snapshot*.json
scripts/.dictionary_facts_verify_batch_state.json
scripts/.dictionary_facts_verify_id_map.json

# date-trivia classification pass (Anthropic Batches API) — same
# resumable checkpoint-state pattern; classify_date_trivia.py regenerates
# these on each run
scripts/.date_trivia_batch_state.json
scripts/.date_trivia_id_map.json

# per-item knowledge-level classification pass (Anthropic Batches API) —
# same resumable checkpoint-state pattern; classify_knowledge_levels.py
# regenerates these on each run
scripts/.knowledge_level_batch_state*.json
scripts/.knowledge_level_id_map*.json

# LOI mild/moderate-tier text-only OCR cleanup (Anthropic Batches API) —
# same resumable checkpoint-state pattern; loi_text_cleanup.py regenerates
# these on each run
scripts/.loi_text_cleanup_batch_state.json
scripts/.loi_text_cleanup_id_map.json
scripts/.loi_text_cleanup_sources_snapshot.json

# reauthor_vague_ref_facts.py (Anthropic Batches API) — same resumable
# checkpoint-state pattern; regenerates these on each run
scripts/.reauthor_vague_batch_state.json
scripts/.reauthor_vague_id_map.json
